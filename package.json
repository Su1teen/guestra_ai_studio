{
  "name": "guestra-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "integrations:generate-config": "node ops/railway/generate-config.mjs",
    "integrations:predeploy": "node ops/railway/predeploy.mjs",
    "test:deployment": "node --test ops/railway/deploy-engine.test.mjs ops/railway/generate-config.test.mjs",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "express": "^5.2.1",
    "lucide-react": "^0.462.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.11"
  }
}
