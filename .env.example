# Production: use a separate PostgreSQL database, never the CRM/PMS database.
DATABASE_URL=
PORT=4310
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:5173
NODE_ENV=development
# Explicit local session, embedded PostgreSQL and fixtures. Never enabled in production.
LOCAL_PREVIEW=true
LOCAL_DATA_DIR=.local/dev-db
MEDIA_DIR=.local/media
MEDIA_SIGNING_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STUDIO_SANDBOX=false
# Base URLs include /api/integrations/agent and /api/v1/connect respectively.
CRM_API_URL=
CRM_API_KEY=
PMS_API_URL=
PMS_API_KEY=
N8N_WEBHOOK_URL=
N8N_CAPABILITIES_URL=
N8N_TOKEN=
N8N_CALLBACK_SECRET=
# Exact permitted hosts, comma separated. Explicitly confirm these are isolated sandboxes.
SANDBOX_ALLOWED_HOSTS=
CRM_PROPERTY_ID=
PMS_PROPERTY_ID=
MEDIA_SCANNER_URL=
MEDIA_SCANNER_TOKEN=
