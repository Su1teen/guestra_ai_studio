# Operator template. Production services are not sandboxes. Never commit filled secrets.
NODE_ENV=production
LOCAL_PREVIEW=false
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=https://guestrastudio.up.railway.app
# Verify existing dedicated postgres_ai_studio first.
DATABASE_URL=${{postgres_ai_studio.DATABASE_URL}}
STUDIO_DATABASE_OWNER=guestra_ai_studio
STUDIO_DATABASE_DEPLOYMENT_ID=
STUDIO_ENVIRONMENT=production
STUDIO_AUTO_MIGRATE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
MEDIA_DIR=/data/media
MEDIA_SIGNING_SECRET=
MEDIA_SCANNER_URL=
MEDIA_SCANNER_TOKEN=
STUDIO_SANDBOX=false
CRM_API_VERSION=v2
CRM_API_URL=https://guestracrm-production.up.railway.app/api/integrations/agent
CRM_API_KEY=
CRM_PROPERTY_ID=
CRM_TENANT_ID=
PMS_API_URL=https://haip-demo-production.up.railway.app/api/v1/connect
PMS_API_KEY=
PMS_PROPERTY_ID=
PMS_TENANT_ID=
# Read-only capability discovery on approved production hosts does not enable writes.
INTEGRATION_ALLOWED_HOSTS=guestracrm-production.up.railway.app,haip-demo-production.up.railway.app
SANDBOX_ALLOWED_HOSTS=
# Add future dedicated Studio HTTPS endpoints/host only after workflow creation.
N8N_WEBHOOK_URL=
N8N_CAPABILITIES_URL=
N8N_TOKEN=
N8N_CALLBACK_SECRET=
N8N_WORKSPACE_IDS=
